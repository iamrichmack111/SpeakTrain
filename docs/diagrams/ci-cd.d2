direction: right
classes: {
  pipeline: {style.fill: "#10201a"; style.stroke: "#59e391"; style.font-color: "#f2f7f4"; border-radius: 14}
}
git: Git Push {class: pipeline; icon: ../icons/github.svg}
tests: Pytest + Docs Checks {class: pipeline; icon: ../icons/test.svg}
browser: Playwright + Screenshots {class: pipeline; icon: ../icons/browser.svg}
container: Docker Build {class: pipeline; icon: ../icons/docker.svg}
registry: GHCR Tagged Image {class: pipeline; icon: ../icons/github.svg}
git -> tests
tests -> browser
browser -> container
container -> registry: latest + semver
